{
  "manifest_version": 3,
  "name": "VTO Watcher",
  "version": "4.6.4",
  "description": "VTO Watcher v4.6.4 adds a dedicated Amazon session-continuation guard that detects and clicks safe Stay logged in prompts independently of the VTO scan loop, while keeping the 4.6.3 live-offer fixes.",
  "permissions": [
    "notifications",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://atoz.amazon.work/*",
    "https://vto-license-server.vto-license-ks.workers.dev/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background_450.js"
  },
  "action": {
    "default_title": "VTO Watcher",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://atoz.amazon.work/*"
      ],
      "js": [
        "license_guard.js",
        "vto_engine_450.js"
      ],
      "css": [
        "content.css",
        "content_450.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://atoz.amazon.work/*"
      ],
      "js": [
        "session_guard_464.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
