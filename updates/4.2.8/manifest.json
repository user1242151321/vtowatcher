{
  "manifest_version": 3,
  "name": "VTO Watcher",
  "version": "4.2.8",
  "description": "VTO Watcher with website-matched rounded UI, safer VTO clicks, blank-page recovery, GitHub-hosted updates, and Cloudflare license validation.",
  "permissions": ["notifications", "storage", "tabs"],
  "host_permissions": [
    "https://atoz.amazon.work/*",
    "https://vto-license-server.vto-license-ks.workers.dev/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": { "service_worker": "background_427.js" },
  "action": {
    "default_title": "VTO Watcher",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://atoz.amazon.work/*"],
      "js": ["license_guard.js", "content.js", "content_patch_428.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
